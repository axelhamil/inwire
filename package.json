{
  "name": "inwire",
  "version": "4.0.0",
  "description": "Type-safe dependency injection for TypeScript. Zero ceremony, full inference, no decorators, no tokens. ~5KB gzip, built-in introspection for AI tooling.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "!dist/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run --typecheck.enabled=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p examples/tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "format:check": "biome format",
    "bench": "tsx benchmarks/resolution.ts",
    "check": "biome check && pnpm typecheck && pnpm check:docs && pnpm test:coverage",
    "check:docs": "tsx scripts/check-docs.ts",
    "example:api": "tsx examples/app/api.ts",
    "example:worker": "tsx examples/app/worker.ts",
    "example:testing": "tsx examples/app/testing.ts",
    "example:scopes": "tsx examples/01-request-scopes.ts",
    "example:introspection": "tsx examples/02-introspection.ts",
    "example:global-modules": "tsx examples/03-global-modules.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "typescript",
    "proxy",
    "ai-first",
    "clean-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelhamil/inwire.git"
  },
  "homepage": "https://github.com/axelhamil/inwire#readme",
  "bugs": {
    "url": "https://github.com/axelhamil/inwire/issues"
  },
  "packageManager": "pnpm@10.26.0",
  "license": "MIT",
  "engines": {
    "node": ">=20.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.23",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
